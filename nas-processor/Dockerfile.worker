FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY nas-processor/ ./nas-processor/
COPY shared/ ./shared/
COPY config/ ./config/

RUN pip install --no-cache-dir \
    -e nas-processor \
    -e shared/nas_config \
    -e shared/nas_contracts

CMD ["python", "-m", "nas_processor.src.worker.consumer"]
